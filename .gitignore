# OS cruft
.DS_Store

# Editor
.vscode/
.idea/

# Python cache (in case any script here ever grows a .py sibling)
__pycache__/
*.pyc

# Logs
*.log

# Personal/local Claude Code settings — never meant to be shared
.claude/settings.local.json

# Ignore local-backlog plugin files (https://github.com/lbecjx/local-backlog)
local-backlog/

# claude plugin eval output — regenerated on every run
evals/results/

# Ignore workflow-dev plugin's own persistent context (per-machine agent state)
.workflow-dev/
